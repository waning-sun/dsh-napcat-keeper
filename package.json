{
  "name": "dsh-napcat-keeper",
  "version": "2.7.0",
  "description": "发现没有能够随着dsh打开自动启动napcat的插件，遂使用大肥鱼制作此插件，建议搭配Yuuyuko-uu的dsh-qq-bridge使用~",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node scripts/check-manifest.mjs && node scripts/check-privacy.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check:fix": "node scripts/check-manifest.mjs --fix",
    "smoke:client": "node scripts/smoke-client.mjs",
    "selftest:scan": "node scripts/selftest-scan.mjs",
    "selftest:setup": "node scripts/selftest-setup.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "napcat",
    "onebot",
    "qq",
    "watchdog",
    "dsh-qq-bridge"
  ],
  "author": "熙的大肥鱼",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dshTarget": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waning-sun/dsh-napcat-keeper.git"
  },
  "homepage": "https://github.com/waning-sun/dsh-napcat-keeper#readme",
  "bugs": {
    "url": "https://github.com/waning-sun/dsh-napcat-keeper/issues"
  }
}
